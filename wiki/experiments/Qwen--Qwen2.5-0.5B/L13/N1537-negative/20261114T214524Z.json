 उल्टा मामले को दफन करने की कोशिशें की जा रही हैं।","tokens":["Mor","ad","abad"," FIR"," �","�","ि�","�","ा�","�","े"," �","�","ए"," �","�","ो"," �","�","�","�","स","र","े"," �","�","े�","�","े"," क","ो"," �","�","ी"," म","ा�","�"," �","�","े�","�","ग","े",","," म","�","�","त"," क","े"," �","�","ा�","�","व"," �","�","ी","ड","ि�","�","ो"," क","े"," �","�","ा�","�","ज","�","�","द"," म","ु","र","ा�","�","ा�","�","ा�","�"," प","ु","ल","ि�","�"," �","�","े"," �","�","ह","ी","ं"," �","�","ि�","�","ा"," �","�","क","्�","�","न","र","\n","द","ं","ग","ल"," म","े�","�"," �","�","ा�","�"," �","�","ं","व","ा�","�","े"," �","�","ा�","�","े"," प","ह","ल","व","ा�","�"," म","ह","े�","�"," क","े"," �","�","ड","�","�","े"," �","�","ा�","�"," �","�","ि�","�","्�","�","ी"," �","�","े"," �","�","त","ा�","�","ा"," क","ि"," �","�","न","ि�","�","ा�","�"," क","ो"," �","�","ं","ग","ल"," क","े"," �","�","य","ो","ज","क"," �","�","र"," �","�","र","ी","द","न","ग","र"," क","े"," प","्र","ध","ा�","�"," स","म","े�","�"," क","र","ी","ब"," ","2","0","-","2","5"," �","�","ो","ग"," �","�","न","क","े"," �","�","र"," �","�","ं","ग","ा�","�","ु","र"," प","ह","ु","ं","च","े","।"," �","�","ि�","�","्�","�","ी"," क","े"," म","ु","त","ा�","�","ि�","�"," �","�","स"," स","म","य"," �","�","ह"," �","�","र"," �","�","न","क","े"," प","ि�","�","ा"," क","ा�","�"," प","र"," �","�","ए"," �","�","े","।"," �","�","र"," प","र"," �","�","न","क","ी"," म","ा�","�"," प","ा�","�","्�","�","त","ी",","," �","�","ा�","�","ी"," �","�","र"," �","�","ह","न"," �","�","ी","।"," �","�","ब","ं","ग","ो","ं"," �","�","े"," म","ा�","�","ल","े"," म","े�","�"," �","�","�","�","स","ल","ा"," क","र","न","े"," क","ा"," �","�","ब","ा�","�"," �","�","ा�","�","ा","।"," �","�","ं","क","ा�","�"," क","र","न","े"," प","र"," �","�","म","क","ी"," �","�","ी"," क","ि"," �","�","ा�","�","े"," म","े�","�"," �","�","ि�","�","ो","र","्�","�"," �","�","ि�","�","ा�","�","े"," �","�","ए"," �","�","ो"," �","�","�","�","स","र","े"," �","�","े�","�","े"," क","ो"," �"