বোর্ডে সহকারী প্রকৌশলী হিসেবে কার্যক্রম পরিদফতরে যোগদান করেন।\nপরবর্তী সময়ে তিনি ২০০১-২০০৪ সাল পর্যন্ত বড়পুকুরিয়া কয়লাভিত্তিক বিদ্যুৎ কেন্দ্র প্রকল্প ও ২০০৫-২০০৭ সাল পর্যন্ত বড়পুকুরিয়া বিদ্যুৎ কেন্দ্রে দায়িত্ব পালন করেন।\nতিনি ২০০৮-২০১৩ পর্যন্ত পরিচালক পাওয়ার সেল, ২০১৪-২০১৫ পর্যন্ত পরিচালক সিস্টেম প্ল্যানিং, ২০১৬-২০১৭ সাল পর্যন্ত প্রধান প্রকৌশলী প্রাইভেট জেনারেশন এবং প্রধান প্রকৌশলী উৎপাদন হিসেবে দায়িত্ব পালন করেন। ব্যক্তিগত জীবনে তিনি দুই কন্যা সন্তানের জনক।\nবার্তাবাজার/কেএ","tokens":["ব","া�","�","ল","া�","�","ে","শ"," �","�","ি�","�","্�","�","�","�","ৎ"," �","�","ন","্�","�","য","�","�","ন"," �","�","�","�","র","্�","�","ে","র"," ","�","�","�","�","ত","ম"," �","�","ে","য","�","�","া","র","ম","্�","�","া�","�"," �","�","ি�","�","ে","ব","ে"," �","�","�","�","গ","দ","া�","�"," �","�","র","ে","ছ","ে","ন"," �","�","্�","�","ক","�","�","শ","ল","�","�"," �","�","া�","�","দ"," �","�","হ","ম","ে","দ","।"," �","�","ঙ","্�","�","ল","ব","া�","�"," �","�","া�","�","ে"," �","�","ই"," �","�","দ","ে"," �","�","ি�","�","�","�","�","�","গ"," �","�","ে","য","�","�","া"," �","�","য","�","�"," �","�","ল","ে"," �","�","ি�","�","্�","�","�","�","ৎ"," �","�","ন","্�","�","য","�","�","ন"," �","�","�","�","র","্�","�","ে","র"," �","�","ন","স","�","�","য","�","�","গ"," �","�","র","ি�","�","ফ","ত","র","ে","র"," �","�","র","ি�","�","া�","�","ক"," �","�","া�","�","ফ","�","�","ল"," �","�","া�","�","া�","�"," �","�","�","�","ধ","�","�","র","�","�"," �","�","ক"," �","�","ি�","�","�","�","ত","ি","র"," �","�","া�","�","্�","�","ম","ে"," �","�"," �","�","থ","্�","�"," �","�","া�","�","া�","�","।","\n","স","া�","�","দ"," �","�","হ","ম","ে","দ"," �","�","�","�","র","্�","�","ব","র","্�","�","�","�"," �","�","ে","য","�","�","া","র","ম","্�","�","া�","�"," �","�","্�","�","ক","�","�","শ","ল","�","�"," �","�","া�","�","ে","দ"," �","�","া�","�","ম","�","�","দ","ে","র"," �","�","্�","�","ল","া�","�","ি�","�","ি�","�","্�","�"," �","�","ল","ে","ন","।"," �","�","র","্�","�","ম","া�","�"," �","�",