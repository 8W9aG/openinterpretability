{"submission": {"identifier": {"model_name": "openai-community/gpt2", "layer": 10, "kind": "dictionary_feature", "dictionary": "gpt2-small-transcoders", "feature_idx": 1417}, "natural_language_explanation": "Fires inside news-report prose about entertainment, celebrity, tech or sports stories, peaking on the source-attribution slot of a reporting construction: the 'to'/'by'/'told' right before a named outlet or recipient ('confirmed to', 'reported by', 'a source told', 'picked up by'), the outlet name itself before a reporting verb ('Variety reported', 'ESPN reported'), 'exclusively', and to a lesser degree 'released/announced on <date>'. It is silent (0, no floor on BOS or the first token) on non-news text such as recipes, domestic narrative or everyday speech, and stays weak (under ~0.3 of max) on bare 'X told Y' or 'by' without a news-story context.", "activating_tokens": [" to", " by", " told", " exclusively", " Variety", " ESPN", " Weekly", " provided", " on"], "counterfactuals": [{"base_prompt": "The movie opens in theaters on Friday, Variety reported.", "counterfactual_prompt": "The soup cooks on the stove on Friday, Grandma reported.", "expected_delta": 0.69, "observed_delta": 0.688081}, {"base_prompt": "The movie opens in theaters on Friday, Variety reported.", "counterfactual_prompt": "The movie opens in theaters on Friday, Mom said.", "expected_delta": 0.45, "observed_delta": 0.448826}, {"base_prompt": "The actor was arrested on Friday. \"He is fine,\" a source told Us Weekly.", "counterfactual_prompt": "The farmer was tired on Friday. \"He is fine,\" his wife said to us.", "expected_delta": 0.71, "observed_delta": 0.712486}, {"base_prompt": "Apple will launch the phone next week, as reported by Bloomberg.", "counterfactual_prompt": "Apple will launch the phone next week, as I told my brother.", "expected_delta": 0.42, "observed_delta": 0.421041}, {"base_prompt": "The new album was leaked online, the singer's label confirmed to Billboard.", "counterfactua