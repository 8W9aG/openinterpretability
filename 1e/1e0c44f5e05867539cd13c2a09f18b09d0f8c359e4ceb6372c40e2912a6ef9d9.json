상, 진실 규명이라는 소기의 목적이 달성됐다고 판단했","tokens":["�","|","\n","이","에"," �","�","�","�","�","�","�","�"," �","�","�","�","�","�","�","�","�","�"," �","�","�","�","�","기","�","�","�","�","�","�","�","은"," 이"," �","�","�","�","�","에","�","�"," �","�","�","�","�","�","을"," �","�","�","�","�"," “","이"," �","�","�","�","�","이"," �","�","�","�","��","의"," 이","�","�","�","�"," �","��","�","�","의"," �","�","�","(","�","�",")","을"," �","�","�","�","�","�","�","�","로"," �","�","�","�","�","한"," �","�","�","�","�","에"," �","�","�","은"," �","�","�","�","�","을"," �","�","�","�","�","한","다","”","�","�"," “","�","�","�","�","�","�","�","�","�","�","�","을"," �","�","�","�"," �","�","�","�","�","�","의","�","�","�","이","�","�","�","고"," ","하","�","�","�","�","�","�","도"," �","�","�","�","�","�"," �","�","�","에","서"," �","�","�","�","�"," �","�","�","�","�","�"," �","�","�","는"," �","�","�","�","�","을"," ‘","�","�","니","�","�"," �","�","고","’"," �","�","�","�","�","로"," �","�","�","�","�","하","는"," �","�","은"," �","�","�","�","�","�","�","�","�","�","�","�","의"," �","�","�","�","�","이","�","�"," �","�","�","�","�","�","�","�","�"," �","�","�","·","�","�","�","�","��","�","�","�"," �","�","�","�","�","�","한"," �","�","�","�","�","”","�","�","�","고"," �","�","�","�","�","�","�","�","다",".","\n","�","�","�","�","�","�"," �","��","�","�","�"," �","�","�"," ‘","�","�","�"," �","��","�","�","’"," �","�","�","�","�","�","�","�","�"," ‘","�","�","�","�","�","�","�","’"," �","�","�","�","�","�","�","�"," �","�","�","�","�","\n","�","�","�","�","�","�","�","�","�"," �","��","�","�","�","�"," �","�","�","�","�","�","�","�","�","�","는"," �","�","�","�","�","�"," �","�","�","�","�","�","�","�"," �","�","�","�","�"," �","�","�","�","�","�","�","�","�","�"," �","��","�","�","�"," �","�","�","�","�","�"," �","�","�","�","�","을"," �","�","기","한"," 이","�","�","�","�","�","�"," �","�","�","�","�","�","�"," 이","�","�","�","�","�"," �","�"," �","�","�","�","�","�","�","�","�","�","�","�"," �","�","�","�","�","�","