ல் பரிந்துரைத்து அந்தக் கோப்பினைக் கடந்த 5 மாதங்களுக்கு முன்பே ஆளுநருக்கு அனுப்பி விட்டது. தமிழக அரசு பரிந்துரைக்குப் பிறகும் ஏழு பேரின் விடுதலை தொடர்பாக ஆளுநர் எந்தவி","tokens":["�","�","�","�","ி","க","�","�","�","�","க"," �","�","�","�","ு","�","�","்","த","ி","�","�","ு","�","�","்","த","�","�","�","�","்"," �","�","�","�","க","்","க","ி","�","�","�","�","�","�","க"," �","�","ி","�","�","ு","த","�","�","�","�"," �","�","ி","�","�","�","�","த","்","த","ி","�","�","ு","க","்","க","ு","�","�","்"," -"," �","�","�","�","�","�","�","�","ி","�","�","�","�","�","�","�","�","்"," �","�","ு","�","�","ி","த","்","த","ு"," �","�","�","�","்","�","�","ு","த","�","�","்","�","�","�","�","�","�","்"," �","�","�","�","த","�","�","�","�","!","\n","�","�","�","�","�","�","�","�","ி","�","�","�","�","�","�","�","�","்"," �","�","�","�","�","�","்","�","�","த","்","த","ி","�","�","்"," �","�","�","�","ி","க","�","�","்"," �","�","�","�","�","�","்"," �","�","�","�","ு","�","�","்","�","�","த","�","�","க","�","�","்"," �","�","ி","�","�","�","�","்"," �","�","�","�","�","�","ு","க","ி","�","�","்","�","�","�","�","�","�","்","."," �","�","�","�","�","�","்"," �","�","�","�","ி","க","�","�","�","�","க"," �","�","�","�","்","�","�","ு","�","�","்"," �","�","�","�","ு","�","�","்","த","ி","�","�","ு","�","�","்","த","�","�","�","�","்"," �","�","�","�","்","�","�","�","�","த","�","�"," �","�","�","�","்"," �","�","க","�","�","்"," �","�","ி","�","�","ு","த","�","�","�","�"," �","�","க","ி"," �","�","�","�","ு","�","�","்","�","�","�","�","�","�","்"," �","�","�","�","�","�","்"," �","�","�","�","�","�","�","�","ி","�","�","�","�","�","�","�","�","ி","�","�","்"," �","�","�","�","்","�","�","�","�"," �","�","�","�","்","�","�","ு","த","�","�","்","�","�","�","�","�","�","்"," �","�","�","�","த","�","�","�","�","�","�","ு","�","�","�","�","்"," �","�","�","�","�","�","ி","�","�","�","�","�","�","்",".","\n","�","�","ு","த","ு","க","்","க","�","�","�","�","்","�","�","�","�","�","�","ி",