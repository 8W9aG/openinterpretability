ी रखते हैं | सतराम कहकर ये आपस में अभिवादन करते हैं | दादू के बाद यह संप्रदाय धीरे-धीरे पांच उपसंप्रदायो में विभाजित हो गया , जो निम्नलिखित हैं -\n\n1 . खालसा \n\n2 . विरक्त तपस्वी \n\n3 .","tokens":["द","ा","द","�","�","द","य","ा","ल"," (","15","44","-","16","03"," �","�",".)"," ह","ि","न","्","द","ी"," क","े"," �","�","क","्","त","ि","क","ा","ल"," म","े","ं"," �","�","्","�","�","ा","न","ा","�","�","्","र","य","ी"," �","�","ा","�","�","ा"," क","े"," प","्","र","म","ु","�","�"," स","न","्","त"," क","व","ि"," �","�","े","�","�"," �","�","न","क","े"," 52"," प","�","�","्","�","�","�","�","ि","�","�","्","य"," �","�","े",","," �","�","ि","न","म","े","ं"," �","�","र","ी","�","�","द","ा","स",","," स","ु","ं","द","र","द","ा","स",","," �","�","�","�","्","�","�","�","�"," �","�","र"," �","�","�","�","न","ा"," म","ु","�","�","्","य"," ह","ै","ं","�","�"," �","�","ा","द","�","�"," क","े"," �","�","ा","म"," स","े"," '","द","ा","द","�","�"," प","ं","�","�","'"," �","�","ल"," प","�","�","ा","�","�"," �","�","े"," �","�","त","्","य","�","�","ि","क"," �","�","य","ा","ल","ु"," �","�","े","�","�"," �","�","स"," क","ा","र","�","�"," �","�","न","क","ा"," �","�","ा","म"," '","द","ा","द","�","�"," �","�","य","ा","ल","'"," प","�","�"," �","�","य","ा","�","�"," �","�","ा","द","�","�"," ह","ि","न","्","द","ी",","," �","�","ु","�","�","र","ा","त","ी",","," �","�","ा","�","�","स","्","�","�","ा","न","ी"," �","�","द","ि"," क","�","�"," �","�","ा","�","�","ा","�","�","ं"," क","े"," �","�","्","�","�","ा","त","ा"," �","�","े","�","�"," �","�","न","्","ह","ो","ं","न","े"," �","�","�","�","द"," �","�","र"," स","ा","�","�","ी"," �","�","ि","�","�","ी","ं","�","�"," �","�","न","क","ी"," �","�","�","�","न","ा"," प","्","र","े","म","�","�","ा","व","प","�","�","र","्","�","�"," ह","ै","�","�"," �","�","ा","त","-","प","ा","�","�","त"," क","े"," �","�","ि","र","ा","क","र","�","�",","," ह","ि","न","्","द","�","�","-","म","ु","स","ल","म","ा","न","ो","ं"," क","ी"," �","�","क","त","ा"," �","�","द","ि"," �