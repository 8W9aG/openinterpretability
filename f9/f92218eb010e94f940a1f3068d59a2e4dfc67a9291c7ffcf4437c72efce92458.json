2824,-0.0,0.10181,0.10719,0.31849,0.23198,0.15727,-0.0,0.32934,0.40147,0.06452,0.22349,0.00452,-0.0,0.10338,0.35345,0.05451,0.19707,0.08404,0.18327,0.04801,-0.0,0.01304,-0.0,0.36085,0.4353,0.09654,0.65199,0.49829,0.67909,-0.0,-0.0,0.05299,0.04942,0.27391,0.29634,0.0124,0.18844,0.42528,0.11248,-0.0,-0.0,-0.0,-0.0,0.00721,0.02974,0.33796,0.57321,-0.0,0.07971,-0.0,0.43189,0.69688,-0.0,0.01472,-0.0,0.10469,-0.0,-0.0,0.2095,0.06292,0.25529,0.45967,0.23462,0.2408,-0.0,0.10891,0.49179,0.18012,-0.0,-0.0,0.26539,0.35718,-0.0,0.11978,0.23617,0.36067,-0.0,0.0248,0.10894,0.35139,-0.0,-0.0,0.06379,0.48381,0.06584,0.53153,-0.0,0.50728,0.18105,0.32538,0.49522,0.51329,0.00839,0.08308],"attends_to":[],"attention_weights":[],"max_activation":4.5974650382995605,"max_token_index":639,"peak_labels":{"hate speech":"none","language":"hi","names":"none","part of speech":"NOUN","personal data":"none","postal addresses":"none","source":"fineweb-2","toxicity":"none"},"text":"जिला स्तरीय परामर्शदात्री समिति (डीएलसीसी) की बैठक मंगलवार को जिला परिषद सभाकक्ष में उप विकास आयुक्त अभय कुमार सिन्हा की अध्यक्षता में हुई। पिछली बैठक का अनुमोदन के साथ एसीपी जून तिमाही की उपलब्धि पर समीक्षा के क्रम में सीडी रेशियो मानक के अनुरूप नहीं होने पर इसे मानक स्तर पर लाने के बैंक के अधिकारियों को निर्देश दिए गए।\nसाथ ही मुद्रा योजना, पीएमईजीपी, एसएचजी, पीएम किसान के लाभुकों को केसीसी की उपलब्धियों की समीक्षा की गई। मौक़े पर सभी बैंकों को एसीपी के तहत दिए गए लक्ष्य को हासिल करने का निर्देश दिया गया। विशेषकर एसबीआई, बैंक ऑफ बड़ौदा, केनरा बैंक, पीएनबी, आईडीबीआई को अपना साख बढ़ाने की हिदायत दी गयी ताकि जिले का साख जमा अनुपात मानक स्तर पर प्राप्त किया जा सके। साथ ही सभी बैंकों को पीएम किसान के लाभुकों को किसान क्रेडिट कार्ड द्वारा आच्छादित करने का निर्देश दिया गया।\nहजारीबाग आकांक्षी जिला अंतर्गत विभिन्न टीएफआईआईपी के तहत दिये गए लक्ष्य यथा प्रधानमंत्री सुरक्षा बीमा योजना, प्रधानमंत्री जीवन ज्योति बीमा योजना एवं अटल पेंशन योजना को सितम्बर माह में पूर्णत प्राप्त करने के लिए सभी बैंकों को विशेष रणनीति के तहत कार्य करने की सलाह दी गयी गई।\nअग्रणी जिला प्रबन्धक ने सभी बैंकों के जिला समन्वयकों से आग्रह किया कि जिले में अपने अधीन समस्त शाखाओं के माध्यम से डिजिटल बैंकिंग के तहत आरबीआई एवं बैंकों द्वारा दिये जाने वाले दिशा निर्देश/सतर्कता के लिए ग्राहकों को जागरूक करने के लिए कहा गया ताकि जिले में साइबर क्राइम जैसे स्पैम ईमेल, हैकिंग, फिशिंग, वायरस, एटीएम/इंटरनेट बैंकिंग के पासवर्ड हैक करना, धोखे से ओटीपी लेना आदि का शिकार बनने से ग्राहक बच सके।\nमौके पर डीडीसी अभय कुमार सिन्हा, अग्रणी जिला प्रबन्धक सुधाकर पांडेय, आरबीआई के सहायक प्रबन्धक विमला भगत, जिला कृषि पदाधिकारी, डीडीएम नाबार्ड ने बैंकों को विशेष सुझाव दिया ताकि अगली त्रैमासिक बैठक तक एसीपी सीडी रेसियो, एग्री एमएसएमई में जिले का प्रदर्शन मानक स्तर तक पहुच सके।","tokens":["ज","ि�","�","ा"," स","्�","�","र","ी","य"," प","र","ा�","�","र","्�","�","द","ा�","�","्र","ी"," स","म","ि�","�","ि"," (","ड","ी","ए","ल","स","ी","स","ी",")"," क","ी"," �","�","�","�","ठ","क"," म","ं","ग","ल","व","ा�","�"," क","ो"," �","�","ि�","�","ा"," प","र","ि�","�","द"," स","भ","ा�","�","क","्�","�"," म","े�","�"," �","�","प"," �","�","ि�","�","ा�","�"," �","�","य","ु","क","्�","�"," �","�","भ","य"," क","ु","म","ा�","�"," स","ि�","�","्�","�","ा"," क","ी"," �","�","ध","्�","�","क","्�","�","त","ा"," म","े�","�"," ह","ु","ई","।"," प","ि�","�","ल","ी"," �","�","�","�","ठ","क"," क","ा"," �","�","न","ु","म","ो","द","न"," क","े"," स","ा�","�"," �","�","स","ी","प","ी"," �","�","�","�","न"," �","�","ि�","�","ा�","�","ी"," क","ी"," �","�","प","ल","ब","्�","�","ि"," प","र"," स","म","ी","क","्�","�","ा"," क","े"," क","्र","म"," म","े�","�"," स","ी","ड","ी"," �","�","े�","�","ि�","�","ो"," म","ा�","�","क"," क","े"," �","�","न","ु","र","�","�","प"," �","�","ह","ी","ं"," ह","ो","न","े"," प","र"," �","�","स","े"," म","ा�","�","क"," स","्�","�","र"," प","र"," �","�","ा�","�","े"," क","े"," �","�","�","�","ं","क"," क","े"," �","�","ध","ि�","�","ा�","�","ि�","�","ो","ं"," क","ो"," �","�","ि�","�","्�","�","े�","�"," �","�","ि�","�"," �","�","ए","।","\n","स","ा�","�"," ह","ी