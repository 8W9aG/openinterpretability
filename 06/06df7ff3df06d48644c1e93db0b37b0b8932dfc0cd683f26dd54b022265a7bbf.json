নালদের বলবেন, বেশি বাড়াবাড়ি না করতে। ...আমি চাই না আবার দুটো ভাগ হোক।’’\nমুকুল রায়ের খাসতালুক কাঁচরাপাড়ায় কর্মিসভা করে তৃণমূলকর্মীদের এ দিন জবরদস্ত ভোকাল টনিক দেওয়ার চেষ্টা করেন মমতা বন্দ্যোপাধ্যায়। কখনও বলেন, ‘‘যদি বাংলার সভ্যতা, সংস্কৃতি, জাগরণ, মাটি, গঙ্গা, যমুনা, পদ্মা,","tokens":[","," �","�","া"," �","�","�","�","ে"," �","�","ে","�","�","ে"," �","�","ি","�","�",","," �","�","ি","�","�","ে","র","া","�","�"," �","�","ি","�","�","্","�","�","�","�"," �","�","া","�","�"," �","�","া","�","�","�","�","ে","�","�"," �","�","া","�","�","’","’","\n","�","�","ি","�","�","ে","�","�","ি","র"," �","�","ি","র","�","�","�","�","্","�","�","ে"," �","�"," �","�","ি","�","�"," �","�","ে","র"," �","�","ি","�","�","া","�","�","�","�"," �","�"," �","�","ি","�","�","্","�","�","ে","�","�","�","�","�","�","�","�","�","�"," �","�","া","�","�","�","�","�","�","�","�","ি","র"," �","�","�","�","ি","�","�","�","�","�","�"," �","�","�","�","�","�","ে","�","�","ে","�","�"," �","�","�","�","�","�","া"," �","�","�","�","্","�","�","্","�","�","�","�","�","�","া","�","�","্","�","�","া","�","�","�","�","�","�"," �","�","ি","�","�","ে","�","�","ি"," �","�","�","�","�","�","া","�","�"," �","�","ি","�","�","্","�","�","�","�","-","�","�","�","�","�","�","�","�","ি","�","�",","," �","�","�","�","�","�","া","�","�"," �","�","া","�","�","া","�","�","ি","-","�","�","�","�","া","�","�","া","�","�","ি",","," �","�","�","�","�","�","া","�","�"," �","�","া","�","�","া","�","�","ি","-","�","�","�","�","র","্","�","�","া"," �","�","ি","�","�","া","�","�","�","�"," �","�","�","�","ি","�","�","�","�","ে"," �","�","�","�","�","�"," �","�","�","�","�","�","া","�","�","�","�"," �","�","র","ে","�","�","ে"," �","�","�","�","ে"," �","�","া","�","�","র"," �","�","া","�","�","ি","�","�"," �","�","া","র"," �","�","র","ে","�","�"," �","�","�","�","�","�","�","�","�","�","�","�"," �","�","ে","�","�","�","�","া","র","�","�","া","র","্","�","�","�","�"," �","�","�","�","ে","�","�",","," ‘","‘","�","�","�","�","া",