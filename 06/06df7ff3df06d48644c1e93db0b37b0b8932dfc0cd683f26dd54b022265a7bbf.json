.14872,0.12257,0.16939,0.16549,0.04634,0.15006,-0.0],"attends_to":[],"attention_weights":[],"max_activation":0.16997119784355164,"max_token_index":706,"peak_labels":{"hate speech":"none","language":"ta","names":"none","personal data":"none","postal addresses":"none","source":"fineweb-2","toxicity":"none"},"text":"By : Oneindia Video Tamil Team\nPublished : January 09, 2018, 11:31\nDuration : 02:10\nவாட்ஸ்அப் சாட், இளம் பெண்ணின் உயிரை குடித்த மதவாதிகள்-வீடியோ\nமுஸ்லீம்களை பிடிக்கும் என வாட்ஸ்அப் சாட்டிங்கில் கருத்து தெரிவித்த ஒரு இளம் பெண் தற்கொலை செய்யும் அளவுக்கு, இந்துத்துவா நபர்களால், தள்ளப்பட்ட சம்பவம் கர்நாடகாவில் பெரும் பரபரப்பை ஏற்படுத்தியுள்ளது. கர்நாடக மாநிலம், மங்களூர் (தென் கனரா), உடுப்பி போன்ற கடலோர மாவட்டங்களும், சிக்மகளூர், ஷிமோகா போன்ற மலை மாவட்டங்களும் மதக் கலவரங்களுக்கு பெயர் பெற்றவை. இங்கு இந்து, முஸ்லிம் பிரிவை சேர்ந்தவர்கள் ஒன்றாக வெளியே நின்று பேசக்கூட முடியாத நிலை உள்ளது.\nஇப்படிப்பட்ட நீருபூத்த நெருப்பாக உள்ள ஒரு பகுதியில்தான் இளம் பூ ஒன்று கருகியுள்ளது. சிக்மகளூர் மாவட்டம், மூடிகெரே என்ற பகுதியை சேர்ந்தவர் தன்யாஸ்ரீ (20). இவர் தனது தோழன் சந்தோஷ் என்பவரிடம் வாட்ஸ்அப் சாட்டில் �","tokens":["By"," :"," One","ind","ia"," Video"," Tamil"," Team","\n","Published"," :"," January"," 09",","," 2018",","," 11",":","31","\n","Duration"," :"," 02",":","10","\n","�","�","�","�","�","�","்","�","�","்","�","�","�","�","்"," �","�","�","�","�","�","்",","," �","�","�","�","�","�","்"," �","�","�","�","�","�","்","�","�","ி","�","�","்"," �","�","�","�","ி","�","�","�","�"," �","�","ு","�","�","ி","த","்","த"," �","�","த","�","�","�","�","த","ி","க","�","�","்","-","�","�","�","�","�","�","ி","�","�","�","�","\n","�","�","ு","�","�","்","�","�","�","�","�","�","்","க","�","�","�","�"," �","�","ி","�","�","ி","க","்","க","ு","�","�","்"," �","�","�","�"," �","�","�","�","�","�","்","�","�","்","�","�","�","�","்"," �","�","�","�","�","�","்","�","�","ி","�","�","்","க","ி","�","�","்"," �","�","�","�","ு","த","்","த","ு"," �","�","�","�","�","�","ி","�","�","