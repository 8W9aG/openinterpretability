িরুদ্ধে অর্থের বিনিময় কাবিননামার টাকার অংক পরিবর্তন, জাল কাবিননামা তৈরিসহ বিভিন্ন অভিযোগ রয়েছে ভুক্তভোগীদের। এক সময়ে জামায়াতের রাজনীতিতে সক্রিয় থাকা এবং বর্তমানে ৪ নং ওয়ার্ডের বিবাহ রেজিষ্টারের কার্যালয়ে বিভিন্ন সময় অপরিচিত লোকদের আনাগোনার বিষয়টি চোখে পড়ে আশপাশের ব্যবসায়ী ও বাসিন্দাদের। সরকারী এ প্রতিষ্ঠানে জাতির জনক বঙ্গবন্ধুর ছবি টানানো নেই এমন অভিযোগ শুনে সংবাদকর্মীরা সেখানে গেলে দেখা যায় প্রধানমন্ত্রীর একটি ছেড়া ছ","tokens":[" �","�","�","�","ে"," �","�","া","�","�","�","�","�","�","�","�","র","্","�","�","ে"," �","�","ে","�","�","�","�","া"," �","�","�","�","�","�","া","�","�","�","�"," �","�","া","�","�","্","�","�","া","র"," �","�","�","�","�","�","ি"," �","�"," �","�","�","�","�","�","�","�","া"," �","�","া","�","�","�","�"," �","�","া","�","�","া","�","�","্","�","�","�","�","র","ে","র","�","�"," �","�","�","�","ে"," �","�","�","�","�","�"," �","�","া","�","�","্","�","�","া","�","�"," �","�"," �","�","�","�","�","�","�","�","া"," �","�","া","�","�","�","�","র"," �","�","া","�","�"," �","�","�","�","ে"," �","�","া","�","�","া"," �","�","ে","�","�","ে","�","�"," �","�","�","�","�","�"," �","�","া","�","�","্","�","�","া","�","�"," �","�","ে","�","�","া","�","�","�","�"," �","�","�","�","�","�","�","�","�","�","�","�","�","�"," �","�","�","�","�","�"," �","�","ি","�","�","ি"," �","�","�","�","�","�","�","�","া",","," �","�","া","�","�","া"," �","�"," �","�","া","�","�","ে","র","�","�","া","�","�","ে"," �","�","া","�","�","ে","�","�"," �","�","�","�","ে"," �","�","া","�","�","া","�","�"," �","�","া","�","�","া","�","�","্","�","�","�","�","র","�","�"," �","�","�","�","ে"," �","�","ি","�","�","ি"," �","�","ি","�","�"," �","�","ে","�","�","া","�","�","�","�"," �","�","ি","�","�","া","�","�","ে"," �","�","�","�","�","�","�","�","�","�"," �","�","ে","�","�","া","�","�","�","�"," �","�","�","�","�","�","ি","�","�"," �","�","া","র"," �","�","�","�","�","�"," �","�","�","�","া","�","�"," �","�","ি","�","�","ে"," �","�","া","র","ে","�","�","�","�","ি"," �