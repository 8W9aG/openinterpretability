अंश रखने वाले सदस्य देशों से चुनकर आते हैं, जबकि 4 सदस्यों का चुनाव सभा द्वारा न्यायपूर्ण भौगोलिक वितरण के आधार पर किया जाता है। निदेशालय का पप्रधान एक महानिदेशक होता।\n\nसन्दर्भ\n\nअंतरराष्ट्रीय संगठन","tokens":["अ","ं","त","र","र","ा�","�","्�","�","्र","ी","य"," स","च","ल"," �","�","प","ग","्र","ह"," स","ं","ग","ठ","न",":"," International"," Mobile"," Set","ellite"," O","oran","ization",":","य","ह"," स","ं","ग","ठ","न","\n","स","ा�","�","ु","द","्र","ि�","�",","," ह","व","ा�","�"," �","�","व","ं"," स","्�","�","ल","ी","य"," स","ं","च","ल","न"," �","�","द","्�","�","े�","�","्�","�","ो","ं"," ह","े�","�","ु"," �","�","प","ग","्र","ह"," स","ं","च","ा�","�"," क","ो"," �","�","ि�","�","ि�","�","म","ि�","�"," क","र","त","ा"," ह","�","�","।"," �","�","स","क","ा"," म","ु","ख","्�","�","ा�","�","य","�","�"," �","�","ं","द","न"," म","े�","�"," स","्�","�","ि�","�"," ह","�","�"," �","�","र"," �","�","ध","ि�","�","ा�","�","ि�","�"," �","�","ा�","�","ा�","�","ं",":"," �","�","ं","ग","्र","े�","�","ी",","," �","�","्र","ा�","�","स","ी","स","ी",","," �","�","�","�","स","ी"," �","�","व","ं"," स","्�","�","े�","�","ि�","�"," �","�","त","्�","�","त","ि"," �","�","व","ं"," �","�","ि�","�","ा�","�"," �","�","ई","ए","म","ए","स","ओ"," क","ा"," �","�","द","्�","�","व"," ","1","9","7","9"," म","े�","�"," �","�","ं","त","र","र","ा�","�","्�","�","्र","ी","य"," स","ा�","�","ु","द","्र","ि�","�"," �","�","प","ग","्र","ह"," स","ं","ग","ठ","न"," (","इ","न","म","ा�","�","स","े�","�",")","प","क","े"," �","�","�","�","प"," म","े�","�"," ह","ु","आ","।"," �","�","ा�","�"," क","े"," �","�","र","्�","�","ो","ं"," म","े�","�"," �","�","न","्�","�","र","न","े�","�"," क","ी"," स","्�","�","ा�","�","न","ा"," स","े"," �","�","ु","ड","�","�","ी"," स","ं","ध","ि"," म","े�","�"," �","�","द","ल","ा�","�"," �","�","ा�","�","े"," ह","ु","ए"," प","इ","स","म","े�","�"," स","्�","�","ल","ी","य"," �","�","व","ं"," �","�","क","ा�","�","ी","य"," स","ं","च","ा�","�"," क","ो"," �","�","ी"," �","�","ा�","�","ि�","�",