,0.45676,0.85467,-0.0,-0.0,0.08318,0.2429,0.15432,0.02975,0.64307,0.99258,0.04221,-0.0,0.22267,0.08016,0.13063,0.48801,0.56218,0.37148,-0.0,-0.0,0.40764,0.26942,-0.0,-0.0,0.11505,0.03398,-0.0,0.45303,0.60391,0.02589,0.04971,0.1529,-0.0,-0.0,0.14239,0.16637,0.20919,0.02522,0.3943,0.74724,0.0055,0.011,0.00507,-0.0],"attends_to":[],"attention_weights":[],"max_activation":3.3202855587005615,"max_token_index":540,"peak_labels":{"hate speech":"none","language":"bn","names":"none","part of speech":"X","personal data":"none","postal addresses":"none","source":"fineweb-2","toxicity":"none"},"text":"নিউজ ডেস্কঃ গাজীপুরের কাপাসিয়ায় ক্রিকেট খেলাকে কেন্দ্র করে মামুন নামে এক কিশোরকে কুপিয়ে হত্যা করেছে বলে অভিযোগ পাওয়া গেছে। গতকাল শুক্রবার রাতে উপজেলার আড়াল এলাকায় এ ঘটনা ঘটে। ঘটনার পর ওই গ্রামের দু’পক্ষের মধ্যে ব্যাপক উত্তেজনা বিরাজ করছে। নিহত কিশোর মামুন একই এলাকার মৃত ফরিদ আহমদের ছেলে। সে এলাকার মেধাবী ক্রিকেটার ছিলেন বলে জানা গেছে। খবর পেয়ে কাপাসিয়া থানা পুলিশ ঘটনাস্থলে গিয়ে পরিস্থিতি শান্ত করার চেষ্টা করছে। ঘটনার সাথে জড়িত সন্দেহে একই এলাকার পরিদাস বর্মণের ছেলে শাওন বর্মণকে গ্রেফতার করেছে পুলিশ।\nএলাকাবাসী জানায়,আড়াল গ্রামের উঠতি বয়সের কিশোররা মিলে আলাদাভাবে বিভিন্ন এলাকায় গিয়ে ক্রিকেট খেলে আসছে। তারই ধারাবাহিকতায় গতকাল শুক্রবার আড়াল স্কুলের মাঠে দু’পক্ষ প্রীতি ম্যাচের আয়োজন করে। খেলায় পরাজিত পক্ষ নিহত মামুনের জন্য বিজয়ী হতে পারেনি বলে আড়াল বাজার এলাকায় ঝগড়ায় লিপ্ত হয়। পরে এলাকাবাসী ঝগড়া মিটিয়ে যার যার বাড়িতে যেতে বলে। কিন্তু বাড়িতে যাবার পথে পূণরায় মামুনের উপর হামলা চালায়ে উপর্যুপুরি ছুরিকাঘাত করে। এ সময় মামুনের চিৎকারে এলাকাবাসী দৌড়ে এসে উদ্ধার করে পাশ্ববর্তী মনোহরদী উপজেলা স্বাস্থ্য কমপ্লেক্সে নিয়ে গেলে চিকিৎসকরা মৃত বলে ঘোষণা করেন। কাপাসিয়া থানার ইন্সপেক্টর (অপরাশেন) মনিরুজ্জমান খান বলেন,খবর পেয়ে দ্রুত ঘটনাস্থলে এসে এলাকাবাসীকে শান্ত করেছি এবং মৃতদেহ উদ্ধার করে থানায় নিয়ে আসি। মামলার প্রস্তুতি চলছে।","tokens":["ন","ি�","�","জ"," �","�","ে","স","্�","�","�","�"," �","�","া�","�","�","�","প","�","�","র","ে","র"," �","�","া�","�","া�","�"