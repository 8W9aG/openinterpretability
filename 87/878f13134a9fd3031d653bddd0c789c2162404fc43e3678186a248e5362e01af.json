.server.web.cmf.include.EntityLinkHelper;\r\nimport com.cloudera.server.web.common.Link;\r\nimport com.google.common.annotations.VisibleForTesting;\r\nimport com.google.common.collect.ImmutableList;\r\nimport com.google.common.collect.ImmutableList.Builder;\r\nimport com.google.common.collect.ImmutableSet;\r\nimport java.util.Collection;\r\nimport java.util.List;\r\n\r\npublic class S3GuardRequiredFieldsValidator extends AbstractObjectStoreValidator\r\n{\r\n\r\n  @VisibleForTesting\r\n  static final String MSG_REQUIRED = \"message.s3guard.validator.requiredValue\";\r\n  private final ImmutableSet<? extends ParamSpec<?>> requiredParams;\r\n\r\n  public S3GuardRequiredFieldsValidator(ImmutableSet<? extends ParamSpec<?>> requiredParams)\r\n  {\r\n    super(false, \"s3guard_required_fields_validator\");\r\n    this.requiredParams = requiredParams;\r\n  }\r\n\r\n  protected Collection<Validation> validate(ServiceHandlerRegistry shr, ObjectStoreConnector connector, ValidationContext context)\r\n  {\r\n    DbExternalAccount account = connector.getAccount();\r\n    if (account == null) {\r\n      return ImmutableList.of();\r\n    }\r\n    try\r\n    {\r\n      boolean enabled = ((Boolean)S3GuardParams.ENABLED.extract(account)).booleanValue();\r\n      if (enabled) {\r\n        return validateRequiredParams(context, account);\r\n      }\r\n      return ImmutableList.of(); } catch (ParamParseException e) {\r\n    }\r\n    throw new RuntimeException(\"Cannot read external account config \" + S3GuardParams.ENABLED.getTemplateName(), e);\r\n  }\r\n\r\n  private List<Validation> validateRequiredParams(ValidationContext context, DbExternalAccount account)\r\n    throws ParamParseException\r\n  {\r\n    ImmutableList.Builder invalids = ImmutableList.builder();\r\n    for (ParamSpec ps : this.requiredParams) {\r\n      if (!isValid(ps, account)) {\r\n        Link link = EntityLinkHelper.getLinkForDialogWithParamSpec(account, ps);\r\n        invalids.add(Validation.error(context, MessageWithArgs.of(\"message.s3guard.validator.requiredValue\", new String[] { ps.getDisplayName() }), link));\r\n      }\r\n\r\n    }\r\n\r\n    return invalids.build();\r\n  }\r\n\r\n  private <T> boolean isValid(ParamSpec<T> ps, DbExternalAccount account)\r\n    throws ParamParseException\r\n  {\r\n    Object currentValue = ps.extract(account);\r\n    Object defaultValue = ps.getDefaultValue(account.getConfigRelease());\r\n    if ((defaultValue != null) && (currentValue.equals(defaultValue))) {\r\n      return false;\r\n    }\r\n    return currentValue != null;\r\n  }\r\n}","tokens":["package"," com",".","cl","ou","der","a",".","cm","f",".","service",".","object","store",";","\r\n\r","\n","import"," com",".","cl","ou","der","a",".","cm","f",".","external","Account","s",".","S","3","Guard","Params",";","\r","\n","import"," com",".","cl","ou","der","a",".","cm","f",".","model",".","Db","External","Account",";","\r","\n","import"," com",".","cl","ou","der","a",".","cm","f",".","service",".","Service","Handler","Registry",";","\r","\n","import"," com",".","cl","ou","der","a",".","cm","f",".","service",".","Validation",";","\r","\n","import"," com",".","cl","ou","der","a",".","cm","f",".","service",".","Validation","Context",";","\r","\n","import"," com",".","cl","ou","der","a",".","cm","f",".","service",".","config",".","Boolean","Param","Spec",";","\r","\n","import"," com",".","cl","ou","der","a",".","cm","f",".","service",".","config",".","Param","Parse","Exception",";","\r","\n","import"," com",".","cl","ou","der","a",".","cm","f",".","service",".","config",".","Param","Spec",";","\r","\n","import"," com",".","cl","ou","der","a",".","enter","prise",".","Message","With","Args",";","\r","\n","import"," com",".","cl","ou","der","a",".","server",".","web",".","cm","f",".","include",".","Entity","Link","Helper",";","\r","\n","import"," com",".","cl","ou","der","a",".","server",".","web",".","common",".","Link",";","\r","\n","import"," com",".","google",".","common",".","a