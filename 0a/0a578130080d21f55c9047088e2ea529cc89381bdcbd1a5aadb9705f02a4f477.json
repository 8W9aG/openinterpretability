（東）區巴士路線發展史》，ISBN 9789628414642，151頁\n\n外部連結\n\n城巴\n 新巴792M線 \n 新巴792M線路線圖 \n其他\n NWFB Bus Route 新巴路線－792M \n\n792M\n792M\n792M\n巴\n792M","tokens":["�","�","�","�","�","，","但","只","需","5","-","10","分","�","�","�","�","�","程","�","�","可","�","�","�","�","，","而","�","�","口","�","�","�","�","只","�","�","�","�","�","�","�","�","�","�","及","明","�","�","�","�","外","，","�","�","能","�","�","�","�","�","�","�","個","�","�","�","�","�","�","�","。","\n","不","少","市","民","�","�","�","�","�","�","�","�","�","及","�","�","�","�","�","�","�","�","�","個","不","同","的","行","政","分","�","�","，","以","�","�","本","�","�","是","�","�","�","�","路","�","�","，","主","要","原","因","是","很","多","市","民","�","�","�","�","�","�","�","�","�","�","�","�","�","作","�","�","�","�","�","的","一","部","分","（","因","其","�","�","�","�","�","�","�","�","�","�","�","�","�","�","�","�","一","�","�","）","，","而","�","�","�","�","�","�","�","�","�","�","�","�","�","�","�","�","市","中","心","�","�","�","�","�","�","�","�","�","�","�","�","�","�","上","在","�","�","�","�","�","�","分","界","之","中","，","�","�","�","�","�","�","�","�","�","�","�","入","�","�","�","�","�","�","�","�","�","�","�","�","，","�","�","�","�","�","�","�","�","�","�","�","�","�","書","�","�","及","�","�","�","�","�","�","的","所","在","地","更","加","是","位","�","�","在","�","�","口","的","�","�","�","�","�","�","�","�","�","�","�","�","政","�","�","�","�","合","大","�","�","�","�","。","\n","\n","�","�","量","\n","由","�","�","例","�","�","日","�","�","有","很","多","民","�","�","到","�","�","�","�","�","�","�","�","�","，","所","以","一","�","�","�","�","�","�","例","�","�","日","�","�","量","比","平","日","多","，","有","些","是","到","�","�","�","�","�","�","�","�","�","到","大","�","�","�","�","、","�","�","�","�","�","�","�","及","�","�","�","�","�","�","�","�","，","而","�","�","�","�","�","�","�","�","�","�","�","�","�","�","�","�","�","�","�","大","�","�","的","一","�","�","，","本","路","�","�","�","�","�","�","�","市","�","�","�","�","�","。","\n","\n","提","�","�","服","�","�","後","，","平","日","除","上","下","