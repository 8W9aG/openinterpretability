法要が執り行われた。\n\n脚注 \n\n大石寺の建築物\n静岡県指定有形文化財\n江戸時代の建築","tokens":["�","�","�","�","�","�","（","み","え","い","ど","う","）","は","、","�","�","�","�","�","�","�","�","�","�","�","�","�","市","、","大","�","�","�","�","に","ある","�","�","�","�","で","、","�","�","�","�","流","�","�","ま","で","の","間","の","本","�","�","と","され","る","建","物","で","ある","。","\n","\n","16","32","年","（","17","世","日","�","�","の","代","）","、","�","�","�","�","�","�","�","�","の","�","�","�","�","によ","り","建","立","され","、","大","�","�","�","�","では","現","存","する","最","�","�","の","建","�","�","物","と","な","る","。","「","本","�","�","�","�","�","�","大","�","�","本","�","�","」","（","現","在","は","�","�","安","�","�","に","安","置","）","が","安","置","され","ていた","時","期","が","あ","った","が","、","建","立","から","50","年","ほ","ど","�","�","って","現","在","安","置","され","ている","常","�","�","�","�","本","�","�","（","日","�","�","�","大","�","�","人","真","�","�","本","�","�","を","模","�","�","）","が","安","置","され","ている","。","�","�","�","�","�","�","の","中","、","本","�","�","の","前","に","日","�","�","�","等","身","大","の","�","�","�","�","像","（","第","6","世","日","時","の","代","、","�","�","前","法","�","�","�","�","�","�","作","）","が","安","置","され","ている","。","\n","\n","内","部","は","�","�","�","�","�","�","�","�","を","模","して","作","られ","て","お","り","、","中","�","�","部","�","�","の","�","�","�","�","�","�","の","上","に","�","�","�","�","�","�","が","あり","、","内","�","�","後","部","中","�","�","に","法","主","の","大","�","�","�","�","�","�","、","大","�","�","�","�","�","�","の","�","�","手","に","�","�","�","�","の","�","�","�","�","�","�","が","ある","。","内","�","�","の","後","方","から","�","�","�","�","�","�","�","�","に","か","け","て","外","�","�","が","�","�","け","られ","ている","。","�","�","には","金","�","�","が","�","�","され","、","内","�","�","や","�","�","間","など","は","�","�","�","�","的","�","�","�","�","が","高","い","と","言","わ","れ","ている","。","\n","\n","�","�","和","41","（","1966","）","年","（","66","世","日","�","�","上","人","代","）","、","�","�","�","�","�","�","�","の","有","�","�","文","化","�","�","に","指","定","され","ている","。","\n","\n","�",