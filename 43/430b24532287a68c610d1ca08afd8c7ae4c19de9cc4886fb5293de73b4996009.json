のサイン色紙が当たるプレゼント企画も12月23日締め切りで実施。コミックトレイル公式Twitterをフォローし、対象ツイートをリツイートした上でメッセージを投稿した人の中から抽選20名にはAmazonギフト券5000円分が贈られる。詳細はキャンペーン告知ページで確認を。","tokens":["�","�","文","社","の","無","�","�","Web","マ","ン","�","�","サ","イ","ト","・","コ","ミ","ック","ト","レ","イ","ル","が","、","明","日","12","月","7","日","で","1","�","�","年","を","�","�","え","る","。","これ","を","記","�","�","した","特","�","�","�","�","画","が","、","本","日","12","月","6","日","に","開","始","した","。","\n","み","な","り","�","�","う","り","ん","「","コ","ロ","と","ち","ー","ち","ゃ","ん","」","、","て","�","�","ー","ろ","ん","た","ろ","ん","「","元","カ","�","�","の","�","�","が","可","�","�","い","って","�","�","」","の","2","本","が","本","日","よ","り","コ","ミ","ック","ト","レ","イ","ル","で","�","�","�","�","開","始","。","12","月","13","日","から","は","�","�","�","�","�","�","�","子","「","�","�","は","�","�","に","3","度","�","�","う","」","、","12","月","20","日","から","は","�","�","場","�","�","�","�","「","社","�","�","と","少","女","の","1800","日","」","、","12","月","27","日","から","は","�","�","�","�","�","�","「","それ","でも","�","�","ら","は","�","�","って","ない","」","の","ス","タ","ート","が","�","�","定","され","ている","。","ま","た","�","�","�","生","�","�","が","同","�","�","�","体","で","�","�","�","�","している","「","の","、","よう","な","。","」","と","同","じ","世","界","�","�","で","�","�","か","れ","る","�","�","み","�","�","り","「","それ","な","り","に","お","�","�","や","って","ます","。","」","を","2020","年","1","月","10","日","ま","で","の","期","間","限","定","で","公","開","。","\n","ま","た","配","信","作","品","の","無","�","�","公","開","�","�","数","を","�","�","�","�","わ","り","で","�","�","量","。","本","日","12","月","6","日","正","�","�","から","9","日","正","�","�","ま","では","�","�","�","�","正","�","�","「","�","�","世","界","でも","�","�","�","�","�","�","�","や","って","み","た","」","、","12","月","13","日","正","�","�","から","16","日","正","�","�","ま","では","�","�","�","�","�","�","�","�","�","テ","「","ア","タ","リ","」","と","�","�","�","�","ほ","な","み","「","カ","ラ","ー�","�","ス","�","�","ール","」","、","12","月","20","日","正","�","�","から","23","日","正","�","�","ま","では","�","�","本","「","�","�","と","�","�","」","と","