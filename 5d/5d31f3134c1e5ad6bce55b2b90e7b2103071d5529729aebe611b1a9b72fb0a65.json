ीं रहें। मधुकरी माँगने यह नित्य मथुरा जाते थे और वहीं उन्होंने श्री अद्वैताचार्य द्वारा प्रकटित श्री मदनगोपाल जी के विग्रह का दर्शन किया। यह उस मूर्ति को वृंदावन लाए और आदित्य","tokens":[" �","�","े"," स","ा","ं","स","ा","र","ि","क"," �","�","ं","�","�","ा","ल"," स","े"," म","ु","क","्","त","ि"," प","ा","न","े"," क","ा"," �","�","�","�","�","�","�","�"," स","ं","क","ल","्","प"," क","ि","य","ा","�","�"," स","�","�","ी"," �","�","ा","�","�","प","द"," प","र"," �","�","े","�","�"," प","र"," स","न","ा","त","न"," �","�","न","म","े","ं"," स","�","�","स","े"," �","�","�","�","�","�","े"," �","�","र"," म","ं","त","्","र","ी","प","द"," प","र"," �","�","े"," �","�","त",":"," प","ह","ल","े"," �","�","्","र","ी"," �","�","�","�","प"," �","�","�","�","ा"," �","�","न","ु","प","म"," स","ा","र","े"," क","ु","�","�","ु","ं","�","�"," क","ो"," स","्","व","�","�","न","्","म","स","्","�","�","ा","न"," �","�","त","े","ह","ा","�","�","ा","द"," �","�","ा","क","ल","ा"," म","े","ं"," स","ु","र","क","्","�","�","ि","त"," �","�","�","�"," �","�","�","�"," �","�","र"," �","�","ा","म","क","े","ल","ि"," �","�","्","र","ा","म"," म","े","ं"," स","न","त","ा","न"," �","�","ी"," क","े"," �","�","ि","�","�"," क","ु","स","म","य"," म","े","ं"," क","ा","म"," �","�","न","े"," क","ो"," क","ु","�","�"," �","�","न"," �","�","क"," �","�","ि","�","�","्","व","स","न","ी","य"," प","ु","र","ु","�","�"," क","े"," प","ा","स"," �","�","�","�","क","र"," �","�","�","�","ं","द","ा","व","न"," क","ी"," �","�","र"," �","�","ल","े"," �","�","�","�","�","�"," �","�","�","�"," स","न","ा","त","न"," �","�","ी"," �","�","े"," �","�","ा","�","�","क","ा","र","्","य"," स","े"," ह","�","�","न","े"," क","ा"," प","्","र","य","त","्","न"," क","ि","य","ा"," �","�","�","�"," �","�","व","ा","�","�"," �","�","े"," �","�","न","्","ह","े","ं"," क","ा","र","ा","ग","ा","र"," म","े","ं"," �","�","ं","द"," क","र","ा"," �","�","ि","य","ा","�","�"," �","�","ं","त"," म","े","ं"," �","�","�","�","स"," �","�","े","क","र"," �","�","ह"," �","�","ं","द"