が、\n自分でも驚くくらい、多くのことを質問し、\n担当医も丁寧に答えてくださいました。\n詳細は、投稿にあげています。\nその次の外来でも、手術について詳しい説明を受け、\nほとんど不安なく臨むことができます。\n来年の入院、手術、その後についても、\n投稿し","tokens":["今","年","は","、","�","�","と","�","�","�","�","された","年","、","�","�","の","元","年","と","な","り","ました","。","\n","来","年","、","す","で","に","手","�","�","を","する","こと","を","�","�","め","ています","。","\n","そ","こ","で","、","そ","こ","に","�","�","った","�","�","�","�","を","も","う","一","度","�","�","り","返","って","み","ました","。","\n","今","年","8","月","、","�","�","路","�","�","�","�","で","入","�","�","した","�","�","に","、","�","�","�","�","�","の","�","�","�","�","�","�","が","見","つ","か","り","ました","。","\n","�","�","合","�","�","�","�","では","、","�","�","�","�","CT","�","�","�","�","�","、","MRI","�","�","�","�","�","でも","、","\n","�","�","性","か","�","�","性","か","の","�","�","�","�","が","つ","か","ない","と","の","�","�","�","�","�","�","果","で","した","。","\n","�","�","期","発","見","は","有","�","�","か","った","もの","の","、","わ","から","ない","と","言","わ","れ","て","も","�","�","り","ます","。","\n","�","�","く","�","�","�","�","を","出","した","い","ので","、","イン","タ","ー�","�","ット","で","い","ろ","い","ろ","と","�","�","べ","ました","。","\n","最","初","、","セ","カ","ン�","�","オ","�","�","ニ","オ","ン","も","�","�","�","�","�","し","ました","が","、","\n","�","�","�","�","保","�","�","の","対","象","と","は","な","ら","ず","、","全","�","�","自","�","�","�","�","�","�","と","な","る","ので","、","除","外","し","ました","。","\n","最","�","�","、","テ","レ","ビ","でも","�","�","�","�","され","ている","�","�","ビ","ン�","�","で","の","手","�","�","に","つ","いて","�","�","べ","た","�","�","果","、","\n","�","�","�","�","�","�","�","の","部","分","�","�","除","手","�","�","が","2016","年","度","よ","り","保","�","�","�","�","用","され","てい","ました","。","\n","さ","ら","に","、","�","�","ビ","ン�","�","手","�","�","の","でき","る","�","�","�","�","を","�","�","した","と","こ","ろ","、","\n","�","�","く","の","�","�","�","�","�","�","�","�","�","�","に","2018","年","8","月","�","�","入","された","こと","も","わ","か","り","ました","。","\n","そ","こ","で","、","�","�","は","�","�","の","�","�","�","�","�","�","�","�","で","�","�","�","�","を","受