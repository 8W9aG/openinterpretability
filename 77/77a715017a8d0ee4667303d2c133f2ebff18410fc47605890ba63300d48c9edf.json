להבי המנוע שלה פגעו בו. הסירה המשיכה בדרכה מבלי לעצור. פגע וברח.\nאז איך כל זה קשור בעצם לליצ׳י תרגומים ולמה אני כותבת על זה בבלוג?\nלפני מספר חודשים יצא מכרז לתרגום מעברית לרוסית ולצרפתית של לקוח שלי: האגף להסמכת כלי שייט ברשות הספנות והנמלים. עם האגף אנחנו עובדים מזה מספר שנים לאחר שזכינו במכרז הקודם לתרגום בחינות ההסמכה לכלי שייט קטנים לאנגלית וערבית וביצענו את התרגום לשביעות רצונם של אנשי האגף, אך מאחר ומדובר בגוף ממשלתי הם א","tokens":["ב","ו�","�"," ו","ו�","�","ק","ה",".","\n","ה","ה","ל","ם"," �","�","ש","ה","ת","ב","ר","ר"," ל","י"," ש","א","נ","י"," מ","כ","י�","�","ה"," א","ת"," ה","�","�","ו�","�","ע"," ה","י�","�"," �","�","�","�","ו�","�","!!"," ה","י�","�"," �","�","ה"," �","�","ד","י�","�","י"," ה","י�","�","ר"," �","�","נ","י"," מ","י","י�","�","ל",","," ה","מ","כ","ו�","�","ה"," ב","פ","י"," �","�","ב","ר","י","ו"," �","�","נ","י"," ב","א","ב","א","ד","י�","�","�","�","�","�",".","\n","א","ת"," �","�","נ","י"," ה","כ","ר","ת","י"," ל","פ","נ","י"," ש","נ","ים"," �","�","ב","ות"," �","�","ש","ש","ח","י�","�","ו"," �","�","ה"," ל","�","�","ד"," �","�","ה"," ב","ב","ר","י�","�","ה",","," �","�","ש","ה","�","�","ע","ת","י"," ל","ח","ו�","�"," �","�","ת","ק","ל","ת","י"," ב","ו"," ל","ע","י�","�","ים"," מ","א","ו�","�"," �","�","ר","ו�","�","ות","."," �","�","ב","ר"," מ","ל","א"," ב","ש","מ","ח","ת"," �","�","י","ים",","," מ","ת","ו�","�","�","�"," �","�","ל"," �","�","ל","י"," ה","ק","ש","ה"," ו","נ","�","�","�","�"," �","�","י�","�","�","�","�","�"," ש","ת","ח","ב","י�","�","ו"," ה","�","�","ד","ו�","�"," ה","י�","�"," �","�","ל","י�","�","ה"," �","�","ו�","�","ש","י�","�",","," ו","ה","ו�","�"," �","�","ש","ה"," �","�","א","ת"," �","�","מ","ע","�","�"," מ","ד","י"," �","�","ו�","�"," ב","ח","ו�","�"," �","�","ל","מ","ח","ים","."," מ","ד","י"," �","�","ע","ם"," �","�","נ","י"," ל","ק","ח"," א","ות","י"," ו","כ","מ","ה"," מ","ח","ב","ר","י"," ל","ר","א","ות"," �","�","�","�","ים"," �","�","מ","ע","נ","י","י�","�","ים","�","�"," ש","ש","ח","ו"," ב","י�"