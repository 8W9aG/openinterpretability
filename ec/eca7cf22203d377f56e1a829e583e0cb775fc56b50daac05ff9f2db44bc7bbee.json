ی ندارم. م","tokens":["س","اب","ق"," ","پ","د","ر","ها"," و"," م","اد","ر","ها"," ","ا","ول","اد"," خ","ود"," ر","ا"," ب","ه"," م","د","ر","س","ه"," ","پ","ی","ش"," �","�","خ","ون","د"," م","ی","ف","ر","ست","اد","ند"," ک","ه"," ق","ر","�","�","ن","خ","و","ان"," و"," خ","ط","خ","و","ان"," ش","ون","د","."," ه","ر"," د","و"," ت","ای","ش","ان"," ر","ا"," د","ر"," ل","ی","ست"," �","�","ر","ز","و","ه","ای"," خ","ود"," �","�","ک","ر"," م","ی","ک","ر","د","ند","."," م","ی","گ","ف","ت","ند"," خ","ط","خ","و","ان"," و"," ق","ر","�","�","ن","خ","و","ان"," ش","ون","د","."," ق","س","م","ت"," ج","ال","ب"," م","ا�","�","ر","ا"," ","ای","ن"," ب","ود"," ک","ه"," ","پ","س"," ا�","�","س","ال","ها"," ه","م","ان"," ","پ","د","ر","ها"," و"," م","اد","ر","ها"," م","ع","م","ول","ا"," ن","م","ی","ف","ه","م","ی","د","ند"," ک","ه"," ","ا","ول","اد","ش","ان"," خ","ط","خ","و","ان"," و"," ق","ر","�","�","ن","خ","و","ان"," ش","د","ه"," ","ی","ا"," ن","ه","."," ع","ل","ت","ا�","�"," ه","م"," ","ای","ن"," ب","ود"," ک","ه"," خ","ود","ش","ان"," ن","ه"," خ","ط"," م","ی","ت","و","ان","ست","ند"," خ","و","ان","د"," و"," ن","ه"," ق","ر","�","�","ن","."," ت","ن","ها"," ج","ای","ی"," ک","ه"," ت","ا�","�","د","ی"," م","ع","ل","و","م"," م","ی","ک","ر","د"," ","�","�","ه"," ک","س","ی"," ق","ر","�","�","ن","خ","و","ان"," ش","د","ه"," ه","م","ان"," م","ر","اس","م"," «","ق","ر","�","�","ن","خ","و","ان","ی","»"," ب","ود"," ک","ه"," ب","ع","ض","ی"," ب","ر","گ","ز","ار"," م","ی","ک","ر","د","ند"," و"," د","ر"," �","�","ن"," ب","ه"," د","ست"," ه","ر","ک","س"," ق","ر","�","�","ن","ی"," م","ی","د","اد","ند"," ک","ه"," خ","ت","م","ا�","�"," ک","ند","."," ه","م","ی","ن"," ک","ه"," م","ی","ت","و","ان","ست","ی"," ","ی","ک"," ج","ز","و"," ق","ر","�","�","ن"," ر","ا"," ت","ا"," �","�","خ","ر"," ب","خ","و","ان","ی","،"," ک","ار"," خ","ت","م"," ب","ود"," و"," ت","و"," ش","د","ه"," ب","ود","ی"," م","ح","ب","و","ب"," د","ل","ها","."," ش","ک","ر",".","\n","د","ر"," �","�","ن"," ر","و","ز","گ","ار","،"," «","پ","و","�","�","ن","ت",