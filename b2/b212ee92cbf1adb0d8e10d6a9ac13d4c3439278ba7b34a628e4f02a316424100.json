:{"bracket depth":"0","hate speech":"none","indent depth":"2","names":"none","part of speech":"PRON","personal data":"none","postal addresses":"none","programming language":"Python","round depth":"0","source":"github-code","syntax construct":"loop","syntax node":"whitespace","toxicity":"none"},"text":"\"\"\"\nPublic Domain\nFred Morcos <fred.morcos@gmail.com>\n\"\"\"\n\nimport pygame\nimport sys\n\nBlockSize = 20\nWinSize = 600\nBoardSize = WinSize / BlockSize\nBlack = pygame.color.Color(\"black\")\nGrey = pygame.color.Color(\"grey\")\n\npygame.init()\npygame.display.set_caption(\"Game of Life - click to draw/erase - press s to start\")\nwin = pygame.display.set_mode((WinSize, WinSize))\n\nclass Board(object):\n\tdef __init__(self):\n\t\tself.blocks = []\n\n\t\tfor i in range(BoardSize):\n\t\t\tlist = []\n\t\t\tfor j in range(BoardSize):\n\t\t\t\tlist.append(0)\n\t\t\tself.blocks.append(list)\n\n\tdef render(self, surface):\n\t\ti = 0\n\t\tj = 0\n\t\twhile i <= WinSize:\n\t\t\tpygame.draw.line(surface, Grey, (i, 0), (i, WinSize))\n\t\t\ti += BlockSize\n\n\t\twhile j <= WinSize:\n\t\t\tpygame.draw.line(surface, Grey, (0, j), (WinSize, j))\n\t\t\tj += BlockSize\n\n\t\tfor i in range(BoardSize):\n\t\t\tfor j in range(BoardSize):\n\t\t\t\tif self.blocks[i][j] == 1:\n\t\t\t\t\tpygame.draw.rect(surface, Black,\n\t\t\t\t\t\t(i * BlockSize, j * BlockSize, BlockSize, BlockSize))\n\n\tdef numOfNeighbors(self, x, y):\n\t\ti = x - 1\n\t\tj = y - 1\n\t\tres = 0\n\n\t\twhile i <= x + 1:\n\t\t\tj = y - 1\n\t\t\twhile j <= y + 1:\n\t\t\t\tif not (i == x and j == y):\n\t\t\t\t\tm = i\n\t\t\t\t\tn = j\n\t\t\t\t\tif i >= BoardSize:\n\t\t\t\t\t\tm = i - BoardSize\n\t\t\t\t\tif j >= BoardSize:\n\t\t\t\t\t\tn = j - BoardSize\n\n\t\t\t\t\tif self.blocks[m][n] == 1:\n\t\t\t\t\t\tres += 1\n\t\t\t\tj += 1\n\t\t\ti += 1\n\t\treturn res\n\n\tdef runOnce(self):\n\t\tres = Board()\n\n\t\tfor i in range(BoardSize):\n\t\t\tfor j in range(BoardSize):\n\t\t\t\tneighbors = self.numOfNeighbors(i, j)\n\t\t\t\tif self.blocks[i][j] == 1 and neighbors < 2:\n\t\t\t\t\tres.blocks[i][j] = 0\n\t\t\t\tif self.blocks[i][j] == 1 and neighbors > 3:\n\t\t\t\t\tres.blocks[i][j] = 0\n\t\t\t\tif self.blocks[i][j] == 1 and (neighbors == 2 or neighbors == 3):\n\t\t\t\t\tres.blocks[i][j] = 1\n\t\t\t\tif self.blocks[i][j] == 0 and neighbors == 3:\n\t\t\t\t\tres.blocks[i][j] = 1\n\t\treturn res\n\nif __name__ == \"__main__\":\n\tclock = pygame.time.Clock()\n\tboard = Board()\n\trun = False\n\twhile True:\n\t\tfor e in pygame.event.get():\n\t\t\tif e.type == pygame.QUIT:\n\t\t\t\tsys.exit()\n\t\t\tif e.type == pygame.MOUSEBUTTONDOWN:\n\t\t\t\ti = e.pos[0] / BlockSize\n\t\t\t\tj = e.pos[1] / BlockSize\n\n\t\t\t\tif board.blocks[i][j] == 1:\n\t\t\t\t\tboard.blocks[i][j] = 0\n\t\t\t\telse:\n\t\t\t\t\tboard.blocks[i][j] = 1\n\t\t\tif e.type == pygame.KEYDOWN and e.key == pygame.K_s:\n\t\t\t\trun = True\n\t\tif run:\n\t\t\tboard = board.runOnce()\n\t\twin.fill((255, 255, 255))\n\t\tboard.render(win)\n\t\tpygame.display.flip()\n\t\tclock.tick(2)","tokens":["\"\"\"","\n","Public"," Domain","\n","Fred"," Mor","cos"," <","fred",".","mor","cos","@","gmail",".","com",">","\n","\"\"\"","\n","\n","import"," py","game","\n","import"," sys","\n","\n","Block","Size"," ="," 20","\n","Win","Size"," ="," 600","\n","Board","Size"," ="," Win","Size"," /"," Block","Size","\n","Black"," ="," py","game",".","color",".","Color","(\"","black","\")","\n","G","rey"," ="," py","game",".","color",".","Color","(\"","grey","\")","\n","\n","py","game",".","init","()","\n","py","game",".","display",".","set","_","caption","(\"","Game"," of"," Life"," -"," click"," to"," draw","/","er","ase"," -"," press"," s"," to"," start","\")","\n","win"," ="," py","game",".","display",".","set","_","mode","((","Win","Size",","," Win","Size","))","\n","\n","class"," Board","(","object","):","\n","\t","def"," __","init","__(","self","):","\n\t","\t","self",".","blocks"," ="," []","\n\n\t","\t","for"," i"," in"," range","(","Board",