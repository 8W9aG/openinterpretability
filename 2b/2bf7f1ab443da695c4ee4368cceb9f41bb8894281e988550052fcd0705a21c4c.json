ศประเทศไทยจะได้รับเงินรางวัล 100,000 บาท พร้อมโอกาสร่วมงานกับนิตยสารฮาร์เปอร์ส บาซาร์ ประเทศไทย สำหรับผู้ชนะเลิศในระดับเอเชีย จะได้รับทุนการศึกษาปริญญาโทในด้าน Fashion and Luxury Brand Management Master Course ที่สถาบันออกแบบ Istituto Marangoni ประเทศอังกฤษ เป็นเวลา 1 ปี มูลค่ากว่า 1","tokens":["�"," ","เ�","�","ิ","ด","เ�","�","ย","ว","่","า"," “","Har","per","’","s"," BA","ZA","AR"," ","ไ","ด","้","ร","่","ว","ม","ท","�","�","ง","า","น","ก","ั","บ","แ","บ","ร","น","ด","�","�","�","�","ั","้","น","น","�","�","ร","ะ","ด","ั","บ","�","�","ล","ก"," ","ห","้","า�","�","ส","ร","ร","�","�","ส","ิ","น","ค","้","า�","�","ั","้","น","น","�","�","ร","ะ","ด","ั","บ","�","�","ร","ะ","เ�","�","�","�","อ","ย","่","า�","�"," Central"," Embassy"," ","ท","�","�","�","�","ห","้","เ�","�","ิ","ด","ม","�","�","ม","ม","อ","ง","ต","ร","ง","ก","ั","น","�","�","น","ก","า�","�","�","�","ล","ั","ก","ด","ั","น","ด","ี","ไ","�","�","เ","น","อ","ร","�","�","ไ","ท","ย","แ","ล","ะ","�","�","น","�","�","�","�","ม","ิ","�","�","า�","�","เ","อ","เ�","�","ี","ย"," ","�","�","ห","้","เ�","�","�","�","น","ท","ี่","ร","�","�","้","จ","ั","ก","ม","า�","�","ย","ิ","่","ง","�","�","�","�","้","น"," ","�","�","ห","้","ม","ี","แ","บ","ร","น","ด","�","�","เ�","�","�","�","น","�","�","อ","ง","ต","น","เ","อ","ง"," ","ม","ี","ร","้","า","น"," ","แ","ล","ะ","�","�","ร","ะ","ส","บ","ค","ว","า�","�","ส","�","�","เ�","�","�","�","จ","�","�","น","ส","า�","�","อ","า�","�","ี","�","�","แ","�","�","�","�","ั","่","น"," ","�","�","ด","ย","�","�","�","�","้","จ","�","�","ด","แ","�","�","�","�","ง","�","�","อ","ง","ค","ว","า�","�","เ�","�","�","�","น","ค","ร","อ","บ","ค","ร","ั","ว"," Harper","’","s"," BA","ZA","AR"," ","ส","�","�","่","อ","ย","ั","ก","�","�","�","�","�","�","ห","�","�","่","�","�","น","ว","ง","ก","า�","�","แ","�","�","�","�","ั","่","น"," ","ไ","ม","่","ว","่","า�","�","ะ","เ�","�","�","�","น","�","�","า�","�","�","�","เ�","�","อ","ร","�","�","ส"," ","บ","า�","�","า�","�","�","�"," ","ส","ิ","ง","ค","�",