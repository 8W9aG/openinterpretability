0.02937,0.04762,0.25956,0.00897,0.02923,0.21335,0.06155,0.48438,0.02794,0.0219,0.02258,0.03574,-0.0,0.01106,-0.0,0.12881,0.01949,0.0227,0.01332,0.02287,-0.0,0.0369,-0.0,0.24547,-0.0,-0.0,-0.0,-0.0,0.45644,0.01762,-0.0],"attends_to":[],"attention_weights":[],"max_activation":5.741715908050537,"max_token_index":1487,"peak_labels":{"hate speech":"none","language":"fa","names":"none","part of speech":"X","personal data":"none","postal addresses":"none","source":"fineweb-2","toxicity":"none"},"text":"یادداشت:باستان گرایی…/دانا مهرنوس\nیادداشت:نقدی بر کلینیک تخصصی پاوه و مشکلات آن…./مهدی مومنی\nپایگاه خبری تحلیلیل سلام پاوه:قبل از هر چیز لازم است متذکر شوم این نوشته ناگفته هایی از قلب و زبان مردمی است که جز با نوشتن و اعتراض کتبی،راهی جهت آرام کردن خود ندارند،(بنا به فرمایشات مقام معظم رهبری؛تنها دغدغه فرد بیمار باید بیماری اش باشد)قطعا در مدت نه چندان دراز از آغاز به کارکلینیک تخصصی نقدها و راه حل هایی در این مورد نوشته شده و اصلاح زودتر این مشکل لازم و ضروری است.با تاملی دقیق بر عملکرد پیشین سیستم درمانی و نحوه کار فعلی این کلینیک،بیشتر به عمق فاجعه پی خواهیم برد.\nقبل از شروع به کار این کلینیک مردم براحتی و در مرکز شهر،حتی با یک تلفن قادر بودند نوبت دلخواه خود راگرفته و در کمال آرامش و صرف حداقل زمان،پزشک مربوطه را ملاقات میکردند.مسئولین عزیز مثلا با الگو پذیری از کلینیک های درمانی سایر شهرها،قصد ارائه خدمات بهداشتی درمانی مطلوب تری به مردم را داشتند،از آن جهت که سیستم نوبت گیری تلفنی اکنون اکثر مشکلات مربوطه را حل کرده و هرکدام از ما به نوعی این مشکل نوبت گیری را تجربه کرده ایم،صحبت از آنها چندان صحیح نیست و لیکن آیا واقعا نوبت دهی تلفنی و یا طراحی سیستم الکترونیکی برای این کار،ممکن نیست؟\nاز ریشه طراحی ساختمان این مرکز برای کلینیک اشتباه است.معمولا در تمام کلینیک های دنیا(غیر از پاوه)مطب هر پزشک در قسمت ورودی خود دارای فضای کافی و مناسبی است که مریض ها در آن محل و با داشتن تمام امکانات منتظر میمانند..اما در کلینیک پاوه نه تنها خبری از امکانات و فضای مناسب نیست،بلکه در همان قسمت ورودی تمام افراد فارغ از جنسیت و نوع بیماری به شکلی کلنی مانند و اکثرا سرپا منتظر میمانند،میدانیم که تغییر ساختمان کنونی ظاهرا غیر ممکن است و گزینه های باقی مانده جهت اصلاح این امر بنظر میرسد تغییر در شیوه نوبت گیری است.\nبا لحاظ کردن کمبود پزشک متخصص ظاهرا چند شیفته کردن کار کلینیک نیز منتفی است.ظاهرا مسئولین عزیز به دنبال کاهش هزینه های تمام شده مردم بودند غافل از اینکه نداشتن تاکسی اختصاصی برای این مسیر و جاده دسترسی کلینیک،هزینه های رفت و آمد را چنانچه با هزینه ویزیت جمع کنیم،همان مبلغ سابق میشود.لذا به نظر میرسد اختصاص تاکسی برای این مسیر و اعمال محدودیت در پارک کردن ماشین ها در اطراف کلینیک نیز باری از مشکلات را بکاهد.چیزی که بیشتر آزار دهنده است،پذیرش ظاهری این روال کاری و بی برنامه از سوی پزشکان مربوطه است چرا که انها نیز خود قربانی این روال کاری بیمار شده اند.وجود پزشک عمومی نیز شاید برای برخی عزیزان که نیازی به متخصص ندارند نیز از حجم افراد در صف بکاهد.یافتن راه حل ها آسان است و دست یافتنی لیکن بازه زمانی کوتاه در اجرای آن میتواند رضایت دوباره مردم را به سوی این کلینیک جلب کند.\nبا تشکر از تمامی سروران گرامی که در این زمینه حوصله به خرج داده و نکاتی را یادآور گردیدند . همه ما این بیت شعر را بارها و بارها شنیده ایم که ((ناله اگر ناله من وگوش اگر گوش تو آنچه به جایی نرسد فریاد است )) عزل و نصب ها توسط نمایندگان منتخب ملت امری اجتناب ناپذیر شده و عزیزانی که در شعارهای تبلیغاتی دم از اجتناب از عزل و نصب می زدند همین که پایشان به مجلس رسید و بر کرسی جلوس اجلال فرمودند تازه فیلشان یاد هندوستان کرده و هرآن کس را مخالف با دیدگاه شریفشان ببینند با تیغ جراحی (معمولا هم به نام تغییر به نفع مردم) از طریق انواع و اقسام اعمال فشارها عزل و نفر بعد را نصب و با سلام و صلوات و ن","tokens":["ی","اد","دا","شت",":","ب","است","ان"," ","گ","ر","ای","ی","…","/","د","انا"," م","هر","ن","وس","\n","ی","اد","دا","شت",":","ن","قد","ی"," بر"," ک","ل","ین","ی","ک"," ت","خصص","ی"," پ","ا","وه"," و"," مش","ک","لات"," آ","ن","…","./","م","هد","ی"," مو","من","ی","\n","پ","ای","گ","اه"," خ","بر","ی"," ت","حل","ی","ل","ی","ل"," س","لام"," پ","ا","وه",":","قبل"," ا","ز"," ه","ر"," ","چ","ی","ز"," ل","از","م"," است"," مت","ذ","ک","ر"," ش","وم"," ا","ین"," ن","وش","ته"," ن","ا","گ","