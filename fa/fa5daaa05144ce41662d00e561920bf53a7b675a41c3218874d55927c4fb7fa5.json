ছাড়াও যুক্তরাষ্ট্র আওয়ামী লীগের নেতা-কর্মীরাও প্রধানমন্ত্রীকে উষ্ণ অভ্যর্থনা জানান। এরপর হোটেল ওয়াল্ডর্ফ এস্টোরিয়ায় যান প্রধানমন্ত্রী শেখ হাসিনা। যুক্তরাষ্ট্র সফরকালে তিনি এ হোটেলে অবস্থান করবেন। হোটেল স্যুটে বসে পবিত্র ঈদ-উল-আযহা উপলক্ষে প্রবাসী ও দেশবাসীকে ঈদের শুভেচ্ছা জানান প্রধানমন্ত্রী। সংবাদ মাধ্যমের সামনে এক শুভেচ্ছা বাণীতে প্রধানমন্ত্রী আশা প্রকাশ করেন, দেশে ও প্রবাসে সকল বাংলাদেশি আনন্দের সঙ্গে ঈদ উদযাপন করতে পারবেন। এসময় দেশকে এগিয়ে নিয়ে যাওয়ার প্রত্যয় পুনর্ব্যক্ত করেন প্রধানমন্ত্রী।\n২৪ সেপ্টেম্বর নিউইয়র্কে ঈদ-উল আজহা উদযাপন করবেন প্রধানমন্ত্রী শেখ হাসিনা। সন্ধ্যায় স্থানীয় একটি হোটেলে ঈদের অভ্যর্থনা অনুষ্ঠানেও যোগ দেবেন তিনি","tokens":["�","�","�","া","�","�","ে","�","�","ে","র"," �","�","্","�","�","া","�","�","�","�","�","�"," �","�","্","র","�","�","ি","�","�","ি","�","�","ি"," �","�","."," �","�","�","�","ে"," �","�","�","�","�","�","�","�","�","�"," �","�","�","�","�","�","ে","�","�","�","�","�","�"," �","�","�","�","�","�","া","�","�","া","�","�","ে","র"," �","�","র","্","�","�","�","�","র","্","�","�","া","র","া","�","�"," �","�","�","�","া","�","�","�","�","া","�","�"," �","�","�","�","�","�","্","�","�","র","া","�","�","্","�","�","্","র"," �","�","�","�","�","�","�","�","া","�","�","�","�"," �","�","�","�","�","�","ে","র"," �","�","ে","�","�","া","-","�","�","র","্","�","�","�","�","র","া","�","�"," �","�","্","র","�","�","া","�","�","�","�","�","�","্","�","�","্","র","�","�","�","�","ে"," �","�","�","�","্","�","�"," �","�","�","�","্","�","�","র","্","�","�","�","�","া"," �","�","া","�","�","া","�","�","�","�"," �","�","র","�","�","র"," �","�","�","�","�","�","ে","�","�"," �","�","�","�","�","�","া","�","�","্","�","�","র","্","�","�"," �","�","�","�","্","�","�","�","�","র","ি","�","�","�","�","া","�","�","�","�"," �","�","া","�","�"," �","�","্","র","�","�","া","�","�","�","�","�","�","্","�","�","্","র","�","�"," �","�","ে","�","�"," �","�","া","�","�","ি","�","�","া","�","�"," �","�","�","�","�","�","্","�","�","র","া","�","