 - 오후 7시, 월요일 휴관\n장소 서울시 동대문구 이문동 346-5 대안공간 346\n문의 The Crane","tokens":["<","�","�","�","�","은"," �","�","�","�","�","�","가","를"," �","�","�","�","어","�","�","다",">","\n","�","�","�","�","�","�","�","�","�",","," �","�","�","�","�","�","�","�","."," single"," channel"," video","\n","<","gap"," 201","40","60","30","454",">"," �","�","�","�","�","�","�","�","�","�","\n","�","�","�","�","�","�",","," �","�","�","�","�","\n","<","�","�","�","�","�","니","�","�","�",">","\n","이","�","�","�","�","�","."," �","�","�","�","�","�","�","�",","," �","�","�","�","�","�","�","�","�","�","\n","�","�","�","�","�","�"," �","�","�","�","�"," �","�","�","�","�","�","에","서","의"," �","�","�","�","를"," �","�","�","해"," �","�","�","�","�"," �","�","�","�","�","가"," �","�","�","�","�","�","의"," �","�","�","리"," �","�","�","에","서"," �","�","�","�","�","�","�","을"," �","�","�","�","�","�","하","는"," 이","�","�","�","�","�"," CY","CLE"," <","�","�","�","�","�","�","�"," �","�","�","�","�",","," �","��"," �","�","�","�","�",">","이"," 5","�","�","�"," 20","�","�","�","�","�","�","�","�"," 6","�","�","�"," 3","�","�","�","�","�","지"," �","�","�","�","�","�","�","�","�","�","�","�","의"," �","�","�","�","�","�","�","�","�"," 346","에","서"," �","�","�","�","�","�","�","�","�","다","."," <","The"," Cr","ane",">","�","�","�","의"," �","�","�"," �","�","�","로","�","�","�","�","�","�","�"," 이","�","�","�"," �","�","�","�","는"," �","�","�","�","�","�",","," �","�","�","�","�","�","�","�",","," �","�","�","�","�","�","�","�","�",","," 이","�","�","�","�","�",","," �","�","�","�","�","�","�","�",","," �","�","�","�","�"," �","�","가","가"," �","�","�","�","�","하","�","�"," �","�","�","�","�",","," �","�","�","�","�",","," �","�","�","�","�"," �","�","�"," �","�","�","�","�","�","로"," �","�","�","�","�","�","어"," �","�","�","�","를"," �","�","�","�","�","�","한","다","."," �","�","�","�","의"," �","�","�","�","�","�","는"," �","�","�","�","�","의"," �","�","�","�","�","에"," �","�","�","�","�","�"," �","�","�","�","�",